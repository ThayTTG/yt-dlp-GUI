<Project Sdk="Microsoft.NET.Sdk">

  <!--
    YT-DLP GUI 3: a mesma lógica da versão 2, com a interface em Avalonia + NokyLabs.UI
    (o Kit NokyLabs, com a cor menta do app).

    No Windows compila para net8.0-windows10 (precisa disso para as notificações "toast");
    no Linux compila para net8.0 (desde a 3.1 o Linux também tem pacote oficial).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- EhWindows: ligado sozinho no Windows (dá para forçar com -p:EhWindows=true para testar a compilação). -->
    <EhWindows Condition="'$(EhWindows)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</EhWindows>
    <TargetFramework Condition="'$(EhWindows)' == 'true'">net8.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(EhWindows)' != 'true'">net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YtDlpGui</AssemblyName>
    <RootNamespace>YtDlpGui</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Versão exibida na barra lateral e no cabeçalho dos logs (ajuda a saber qual build gerou um erro). -->
    <Version>3.1.0</Version>
    <Product>YT-DLP GUI</Product>
    <AssemblyTitle>YT-DLP GUI</AssemblyTitle>
    <Company>NokyLabs</Company>
    <!-- Ícone exibido no .exe, no Explorer e na barra de tarefas. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(EhWindows)' == 'true'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.*" />
    <!-- Notificações "toast" do Windows (as mesmas usadas no CubeBin). -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3"
                      Condition="$(TargetFramework.Contains('-windows'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- O Kit NokyLabs (submódulo Git em lib/NokyLabs.UI). -->
    <ProjectReference Include="..\..\lib\NokyLabs.UI\src\NokyLabs.UI\NokyLabs.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ícones e telas vão DENTRO do programa (não há mais pasta Assets solta). -->
    <AvaloniaResource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- icon.ico também fica ao lado do .exe (o pacote e o launcher conferem que ele existe). -->
    <None Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <!--
      Módulo opcional de Filtro de Conteúdo (ver FiltroConteudo.cs).
      Isto é só o ARQUIVO DE EXEMPLO — copiá-lo para a saída não ativa nada.
      Para ativar de fato, copie/renomeie para "filtro-conteudo.json" na
      pasta do .exe. Veja o README.md, seção "Filtro de conteúdo (opcional)".
    -->
    <None Include="filtro-conteudo.exemplo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
