<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YtDlpGui</AssemblyName>
    <RootNamespace>YtDlpGui</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <LangVersion>latest</LangVersion>
    <!-- Ícone exibido no .exe, no Explorer e na barra de tarefas. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Guna.UI2.WinForms: biblioteca de controles com visual moderno
      (botões arredondados, cores customizáveis, etc.) usada para
      modernizar a interface do programa.

      IMPORTANTE: rodar "dotnet restore" (ou simplesmente compilar) exige
      conexão com a internet na primeira vez, para baixar o pacote do NuGet.
    -->
    <PackageReference Include="Guna.UI2.WinForms" Version="2.0.4.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Garante que o icon.ico seja copiado para a pasta de saída (para
         ser usado em tempo de execução como Form.Icon, além de já estar
         embutido no .exe via ApplicationIcon acima). -->
    <None Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ícones e ilustrações usados nas telas (barra lateral, botões, etc.). -->
    <None Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      Módulo opcional de Filtro de Conteúdo (ver FiltroConteudo.cs).
      Isto é só o ARQUIVO DE EXEMPLO — copiá-lo para a saída não ativa nada.
      Para ativar de fato, copie/renomeie para "filtro-conteudo.json" na
      pasta do .exe. Veja o README.md, seção "Filtro de conteúdo (opcional)".
    -->
    <None Include="filtro-conteudo.exemplo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      IMPORTANTE:
      Se você quiser que o yt-dlp.exe e o ffmpeg.exe sejam copiados
      automaticamente para a pasta de saída (bin\Debug\net8.0-windows)
      sempre que compilar, coloque os arquivos numa pasta "tools" ao lado
      deste .csproj e descomente as linhas abaixo.
    -->
    <!--
    <None Include="tools\yt-dlp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tools\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    -->
  </ItemGroup>

</Project>
